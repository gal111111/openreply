# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# 選用：HobbyLand 統一登入（OIDC）。CLIENT_ID 及 CLIENT_SECRET 均已設定時，
# 登入頁才顯示「使用 HobbyLand 統一登入」按鈕；電郵登入連結照常保留。
# 須在中央身份服務登記以下精確回調網址（callback）：
#   https://openreply.up.railway.app/api/auth/callback/hobbyland
# 回調網址由 NEXTAUTH_URL 決定，須與登記網址完全一致。
# 流程：authorization code + PKCE S256，並檢查 state 及 nonce；
# 以 client_secret_basic 向 token endpoint 驗證；scope 為「openid email」。
# CLIENT_SECRET 至少 32 個字元，只存放於部署平台的機密設定，不得提交入版本庫。
# HOBBYLAND_SSO_ISSUER=https://auth.hobbyland-group.com
# HOBBYLAND_SSO_CLIENT_ID=openreply
# HOBBYLAND_SSO_CLIENT_SECRET=
#
# 登入授權（全部條件由本系統判斷，中央服務只負責驗證身份）：
# 1. 中央服務回傳 email_verified 必須為 true，否則一律拒絕；
# 2. 並須符合以下其中一項：本系統已有相同電郵的用戶；該中央 subject 已連結
#    本系統用戶；或電郵／subject 列於 HOBBYLAND_SSO_ALLOWED（JSON 陣列）。
# ALLOWED_EMAILS 如已設定，同樣適用於統一登入。
# 經 HOBBYLAND_SSO_ALLOWED 首次登入的新用戶不會自動建立工作區，須由工作區
# 擁有者或管理員以其電郵發出邀請；工作區角色只在本系統管理。
# HOBBYLAND_SSO_ALLOWED=["new.staff@hobbyland-group.com","<中央 subject>"]

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# HobbyLand 系統互通（/api/integrations/v1/...）
# 允許其他 HobbyLand 系統呼叫本系統的系統鑰匙清單（JSON）。只存鑰匙的 sha256，
# 不存明文。鑰匙格式為 hlk_<呼叫方代號>_<32 位以上隨機字元>，例如 hub 用來建立
# 自動私訊（automations:write／automations:read），App 門戶讀取待辦數量
# （summary:read）。未設定時，系統鑰匙存取一律回 401，用戶登入功能不受影響。
# 計算 hash：printf '%s' 'hlk_hub_xxxx' | shasum -a 256
# HOBBYLAND_SERVICE_KEYS={"hub":{"sha256":"<鑰匙的 sha256 hex>","scopes":["automations:write","automations:read","summary:read"]}}

# 呼叫方沒有指定 workspace 時使用的預設工作區（工作區 id 或名稱）。
# 系統鑰匙讀取待辦數量時亦只統計此工作區；未設定則統計全部工作區。
# OPENREPLY_DEFAULT_WORKSPACE=
